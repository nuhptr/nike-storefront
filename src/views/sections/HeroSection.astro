---
import { ArrowRight } from "lucide-react"
import type { ShoeVariant, StoreStatistic } from "@models/storefront.model"
import { HeroShowcaseIsland } from "@views/components/HeroShowcaseIsland"
import { badgeVariants } from "@views/components/ui/badge"
import { buttonVariants } from "@views/components/ui/button"
import { cn } from "@views/components/ui/cn"

/**
 * Hero landing section pairing above-the-fold headline copy, brand statistics,
 * and the interactive `HeroShowcaseIsland` sneaker switcher.
 *
 * Hydration strategy:
 * - Uses `client:load` on `<HeroShowcaseIsland />` because the sneaker selector
 *   is immediately visible above the fold and should respond on first paint.
 */
interface Props {
    /** Selectable sneaker variants passed to `HeroShowcaseIsland`. */
    shoes: readonly ShoeVariant[]
    /** Key brand metrics rendered below the primary CTA buttons. */
    statistics: readonly StoreStatistic[]
}

const { shoes, statistics } = Astro.props
---

<section
    id="home"
    class="grid items-center grid-cols-1 px-6 pt-10 pb-20 storefront-container gap-14 sm:px-12 lg:px-16 xl:grid-cols-12 xl:gap-12 xl:py-16">
    <div class="flex flex-col items-start xl:col-span-5">
        <span class={cn(badgeVariants({ variant: "default" }))}>Our Summer Collection</span>

        <h1 class="mt-6 font-display text-5xl font-bold leading-tight tracking-tight text-foreground sm:text-7xl xl:text-hero">
            The New Arrival
            <span class="block mt-1">
                <span class="text-primary">Nike</span>Shoes
            </span>
        </h1>

        <p class="max-w-md mt-6 text-lg leading-relaxed text-muted-foreground">
            Discover stylish Nike arrivals, quality comfort, and innovation crafted for your active
            life.
        </p>

        <div class="flex flex-wrap items-center gap-4 mt-9">
            <a href="#products" class={cn(buttonVariants({ variant: "default", size: "lg" }))}>
                <span>Shop now</span>
                <ArrowRight className="size-4" aria-hidden="true" />
            </a>
            <a href="#about-us" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
                <span>Learn more</span>
            </a>
        </div>

        <dl class="grid w-full max-w-md grid-cols-3 gap-6 pt-8 border-t mt-14 border-border/80">
            {statistics.map((item) => (
                <div>
                    <dt class="text-sm font-medium text-muted-foreground">{item.label}</dt>
                    <dd class="mt-1 text-3xl font-bold tracking-tight font-display text-foreground sm:text-4xl">
                        {item.value}
                    </dd>
                </div>
            ))}
        </dl>
    </div>

    <div class="xl:col-span-7">
        <!-- `client:load` hydrates immediately since the shoe showcase is above the fold. -->
        <HeroShowcaseIsland shoes={shoes} client:load />
    </div>
</section>
