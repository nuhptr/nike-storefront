---
import { ArrowRight } from "lucide-react"
import { badgeVariants } from "@views/components/ui/badge"
import { buttonVariants } from "@views/components/ui/button"
import { cn } from "@views/components/ui/cn"

/**
 * Super Quality editorial section highlighting craftsmanship and featured footwear imagery.
 */
---

<section
    id="about-us"
    class="grid items-center grid-cols-1 gap-12 px-6 py-16 storefront-container sm:px-12 sm:py-24 lg:grid-cols-12 lg:px-16">
    <div class="flex flex-col items-start lg:col-span-6">
        <span class={cn(badgeVariants({ variant: "default" }))}>Craftsmanship</span>
        <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight capitalize font-display text-foreground sm:text-5xl lg:max-w-lg">
            We Provide You<span class="text-primary">Super Quality</span>Shoes
        </h2>
        <p class="max-w-lg mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
            Ensuring premium comfort and style, our meticulously crafted footwear is designed to
            elevate your experience, providing you with unmatched quality, innovation, and a touch
            of elegance.
        </p>
        <p class="max-w-lg mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
            Our dedication to detail and excellence ensures your satisfaction on every stride.
        </p>
        <div class="mt-9">
            <a href="#products" class={cn(buttonVariants({ variant: "default", size: "lg" }))}>
                <span>View details</span>
                <ArrowRight className="size-4" aria-hidden="true" />
            </a>
        </div>
    </div>

    <div class="flex items-center justify-center p-8 border rounded-3xl border-border/70 bg-surface-tint lg:col-span-6">
        <img
            src="/images/promo/shoe8.svg"
            alt="Nike Super Quality featured sneaker"
            width={570}
            height={522}
            loading="lazy"
            class="object-contain w-full h-auto max-w-130"
        />
    </div>
</section>
