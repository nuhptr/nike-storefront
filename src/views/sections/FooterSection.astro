---
import type { FooterLinkGroup, SocialLink } from "@models/storefront.model"

/**
 * Storefront site footer rendering brand copy, social links, grouped navigation columns,
 * and copyright attribution.
 */
interface Props {
    /** Grouped footer link columns supplied by `StorefrontViewModel.footer`. */
    footerLinkGroups: readonly FooterLinkGroup[]
    /** Social network icon links supplied by `StorefrontViewModel.footer`. */
    socialLinks: readonly SocialLink[]
}

const { footerLinkGroups, socialLinks } = Astro.props
const currentYear = new Date().getFullYear()
---

<footer class="bg-slate-950 text-slate-300">
    <div class="px-6 pt-16 pb-10 storefront-container sm:px-12 sm:pt-20 lg:px-16">
        <div class="flex flex-wrap items-start justify-between gap-16 max-lg:flex-col">
            <div class="flex flex-col items-start max-w-sm">
                <a href="#home" aria-label="Nike Storefront home">
                    <img
                        src="/images/brand/footer-logo.svg"
                        alt="Nike logo"
                        width={150}
                        height={46}
                        loading="lazy"
                    />
                </a>
                <p class="mt-6 text-sm leading-7 text-slate-400">
                    Get shoes ready for the new term at your nearest Nike store. Find your perfect
                    size in store and unlock member rewards.
                </p>

                <div class="flex items-center gap-3 mt-7">
                    {socialLinks.map((social) => (
                        <a
                            href={social.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={social.label}
                            class="inline-flex size-11 items-center justify-center rounded-full bg-white text-slate-950 transition-transform duration-200 hover:-translate-y-0.5 hover:bg-primary/90">
                            <img
                                src={social.iconSrc}
                                alt=""
                                width={20}
                                height={20}
                                loading="lazy"
                                aria-hidden="true"
                            />
                        </a>
                    ))}
                </div>
            </div>

            <div class="grid flex-1 grid-cols-2 gap-10 sm:grid-cols-3 lg:gap-12">
                {footerLinkGroups.map((group) => (
                    <div>
                        <h3 class="text-lg font-semibold text-white font-display">{group.title}</h3>
                        <ul class="mt-4 flex flex-col gap-2.5">
                            {group.links.map((item) => (
                                <li>
                                    <a
                                        href={item.href}
                                        class="text-sm transition-colors text-slate-400 hover:text-white">
                                        {item.name}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>

        <div class="flex flex-col items-center justify-between gap-4 pt-8 mt-16 text-sm border-t border-white/10 text-slate-400 sm:flex-row">
            <p class="inline-flex items-center gap-2">
                <img
                    src="/icons/ui/copyright-sign.svg"
                    alt=""
                    width={16}
                    height={16}
                    loading="lazy"
                    aria-hidden="true"
                />
                <span>{currentYear}Nike Storefront. All rights reserved.</span>
            </p>
            <a href="#home" class="transition-colors hover:text-white">
                Terms &amp; Conditions
            </a>
        </div>
    </div>
</footer>
