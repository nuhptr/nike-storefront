---
import { ArrowRight } from "lucide-react"
import { badgeVariants } from "@views/components/ui/badge"
import { buttonVariants } from "@views/components/ui/button"
import { cn } from "@views/components/ui/cn"

/**
 * Special Offers promotional section pairing seasonal imagery with dual CTA links.
 */
---

<section class="grid items-center grid-cols-1 gap-12 px-6 py-16 storefront-container sm:px-12 sm:py-24 lg:grid-cols-12 lg:px-16">
    <div class="flex items-center justify-center order-2 lg:order-1 lg:col-span-6">
        <img
            src="/images/promo/offer.svg"
            alt="Nike special seasonal offer showcase"
            width={773}
            height={687}
            loading="lazy"
            class="object-contain w-full h-auto max-w-150"
        />
    </div>

    <div class="flex flex-col items-start order-1 lg:order-2 lg:col-span-6">
        <span class={cn(badgeVariants({ variant: "default" }))}>Limited Time</span>
        <h2 class="mt-5 text-4xl font-bold leading-tight tracking-tight capitalize font-display text-foreground sm:text-5xl">
            <span class="text-primary">Special</span>Offer
        </h2>
        <p class="max-w-lg mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
            Embark on a shopping journey that redefines your experience with unbeatable deals. From
            premier selections to incredible savings, we offer unparalleled value that sets us
            apart.
        </p>
        <p class="max-w-lg mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
            Navigate a realm of possibilities designed to fulfill your unique desires, surpassing
            the loftiest expectations. Your journey with us is nothing short of exceptional.
        </p>
        <div class="flex flex-wrap items-center gap-4 mt-9">
            <a href="#products" class={cn(buttonVariants({ variant: "default", size: "lg" }))}>
                <span>Shop now</span>
                <ArrowRight className="size-4" aria-hidden="true" />
            </a>
            <a href="#contact-us" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
                <span>Learn more</span>
            </a>
        </div>
    </div>
</section>
