---
import type { ServiceHighlight } from "@models/storefront.model"

/**
 * Presentational service highlight card rendered inside `ServicesSection`.
 * Displays a storefront benefit with an icon badge, headline, and supporting copy.
 */
interface Props {
    /** Service guarantee item to render. */
    service: ServiceHighlight
}

const { service } = Astro.props
---

<article class="flex flex-col rounded-2xl border border-border/80 bg-card p-8 shadow-elevated transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover">
    <div class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary text-primary-foreground shadow-sm">
        <img src={service.iconSrc} alt="" width={24} height={24} aria-hidden="true" />
    </div>
    <h3 class="mt-6 font-display text-2xl font-bold leading-snug text-foreground">
        {service.label}
    </h3>
    <p class="mt-3 text-base leading-relaxed text-muted-foreground">{service.subtext}</p>
</article>
