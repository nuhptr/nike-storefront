---
import type { Product } from "@models/storefront.model"

/**
 * Presentational product card rendered inside `PopularProductsSection`.
 * Uses a semantic `<article>` root and lazy-loaded footwear media.
 */
interface Props {
    /** Catalog product entity to display. */
    product: Product
}

const { product } = Astro.props
---

<article class="group flex flex-col overflow-hidden rounded-2xl border border-border/80 bg-card transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover">
    <div class="relative flex aspect-square items-center justify-center overflow-hidden bg-surface-tint p-6">
        {product.badge && (
            <span class="absolute top-4 left-4 z-10 inline-flex items-center rounded-full border border-primary/20 bg-background/90 px-3 py-1 text-xs font-semibold text-primary backdrop-blur-xs">
                {product.badge}
            </span>
        )}
        <img
            src={product.imgURL}
            alt={product.name}
            width={280}
            height={280}
            loading="lazy"
            class="size-full object-contain transition-transform duration-300 group-hover:scale-105"
        />
    </div>

    <div class="flex flex-1 flex-col gap-2 p-5">
        <div class="flex items-center justify-between text-xs font-medium text-muted-foreground">
            <span>{product.category}</span>
            <span class="inline-flex items-center gap-1.5 text-sm font-medium text-foreground">
                <img src="/icons/ui/star.svg" alt="" width={16} height={16} aria-hidden="true" />
                <span>({product.rating.toFixed(1)})</span>
            </span>
        </div>

        <h3 class="font-display text-xl font-bold leading-snug text-foreground">{product.name}</h3>

        <p class="mt-auto pt-2 text-lg font-bold text-primary">{product.price}</p>
    </div>
</article>
