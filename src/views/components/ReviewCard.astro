---
import type { CustomerReview } from "@models/storefront.model"

/**
 * Presentational customer testimonial card rendered inside `CustomerReviewsSection`.
 * Displays a lazy-loaded avatar, quote, star rating, reviewer name, and role.
 */
interface Props {
    /** Customer testimonial entity to display. */
    review: CustomerReview
}

const { review } = Astro.props
---

<article class="flex flex-col items-center rounded-3xl border border-border/80 bg-card p-8 text-center shadow-elevated">
    <img
        src={review.imgURL}
        alt={review.customerName}
        width={96}
        height={96}
        loading="lazy"
        class="size-24 rounded-full object-cover ring-4 ring-primary/10"
    />
    <p class="mt-6 max-w-md text-base leading-relaxed text-muted-foreground">
        &ldquo;{review.feedback}&rdquo;
    </p>
    <div class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-surface-tint px-3.5 py-1 text-sm font-semibold text-foreground">
        <img src="/icons/ui/star.svg" alt="" width={16} height={16} aria-hidden="true" />
        <span>{review.rating.toFixed(1)}</span>
    </div>
    <h3 class="mt-3 font-display text-2xl font-bold text-foreground">{review.customerName}</h3>
    <p class="text-sm text-muted-foreground">{review.role}</p>
</article>
