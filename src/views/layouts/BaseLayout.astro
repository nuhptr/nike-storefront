---
import "@styles/index.css"
import type { SiteMeta } from "@models/storefront.model"

/**
 * Base HTML layout shell for Nike Storefront pages.
 * Renders SEO metadata, Google Fonts (`Palanquin` & `Montserrat`), and global Tailwind v4 styles.
 */
interface Props {
    /** Document metadata slice supplied by `StorefrontViewModel.meta`. */
    meta: SiteMeta
}

const { meta } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={meta.description} />
        <meta name="keywords" content={meta.keywords} />
        <meta name="author" content={meta.author} />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Palanquin:wght@500;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{meta.title}</title>
    </head>
    <body class="min-h-screen antialiased bg-background text-foreground selection:bg-primary/15 selection:text-primary">
        <slot />
    </body>
</html>
